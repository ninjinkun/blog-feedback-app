{
  "name": "blog-feedback-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build --mode staging",
    "build:production": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/junit/junit.xml",
    "test:compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint src",
    "eslint:fix": "eslint --fix src",
    "prettier": "prettier --write './src/**/*.{ts,tsx}'",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@reduxjs/toolkit": "^2.12.0",
    "fetch-jsonp": "^1.4.0",
    "firebase": "^12.16.0",
    "lodash": "^4.18.1",
    "normalize.css": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.2.0",
    "redux-saga": "^1.5.0",
    "styled-components": "^6.4.3",
    "ua-parser-js": "^1.0.41",
    "xml-js": "^1.6.11"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "es5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.23.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
